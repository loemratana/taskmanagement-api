<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy: https://taskapi.company.com -> http://localhost:8082
  Needs the IIS "URL Rewrite" and "Application Request Routing" modules, with
  ARR > Server Proxy Settings > "Enable proxy" ticked.
  Put this file in the IIS site's physical folder (C:\inetpub\taskapi, as in README.md).
  For MinIO make a second site (taskfiles.company.com) with the same file pointing at your MinIO API port
  (default 9000). Not the console port (often 9001, the /login page): that is only the admin UI.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToApi" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8082/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Match UPLOAD_MAX_REQUEST_SIZE (100MB). IIS default is ~30MB. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
