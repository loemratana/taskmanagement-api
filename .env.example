# Copy this file to `.env` (local/dev) and fill in real values.
# For a production deployment, provide these as real environment variables
# (or a separate untracked `.env.production`) — never reuse dev secrets.

# =========================
# Spring
# =========================
# dev = local defaults, verbose logging, ddl-auto=update
# prod = requires every secret below to be set explicitly, ddl-auto=validate
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=tms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DB_HOST=localhost
DB_PORT=5432

# Optional: use another database (e.g. Neon) instead of the local one above. All three together.
# For Neon use the DIRECT endpoint (no "-pooler" in the host): the API pools its own connections,
# and Flyway migrations need a direct session. JDBC spells it channelBinding (Neon's URL says channel_binding).
# DB_URL=jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channelBinding=require
# DB_USERNAME=
# DB_PASSWORD=
# Optional tuning: wait for a connection (ms), and connections kept open.
DB_CONNECT_TIMEOUT_MS=30000
DB_POOL_SIZE=10

# =========================
# Redis
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379

# =========================
# pgAdmin (dev only)
# =========================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# =========================
# MinIO (S3-compatible storage)
# =========================
# Password must be at least 8 characters
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ENDPOINT=http://localhost:9100
MINIO_BUCKET=taskmanagement

# =========================
# JWT
# =========================
# Generate a strong random secret, e.g.: openssl rand -base64 48
# Use a DIFFERENT secret per environment — never share dev/prod.
JWT_SECRET=
# Refresh token lifetime (ms), default 7 days. Rotates on use, so it is an idle timeout.
JWT_EXPIRE=604800000
# Access token lifetime (ms), default 15 min. Keep short: revoked sessions only end when it expires.
JWT_ACCESS_TOKEN_EXPIRATION=900000

# =========================
# Frontend / CORS
# =========================
CLIENT_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =========================
# SMTP
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Connect / read / write timeout (ms), so a stuck mail server can't hang a sending thread.
SMTP_TIMEOUT_MS=10000
NOTIFICATION_EMAIL_ENABLED=false

# =========================
# Notification delivery (push / email / Telegram)
# =========================
# Total tries per delivery including the first: 1 + one per back-off step.
NOTIFICATION_RETRY_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_INTERVAL_MS=60000
# Minutes to wait before each retry; the last repeats. About an hour of provider outage is ridden out.
NOTIFICATION_RETRY_BACKOFF_MINUTES=1,2,5,15,30
# A delivery still unsent this long after creation lost its dispatch (restart / crash) and is resent.
NOTIFICATION_STUCK_AFTER_MINUTES=10
NOTIFICATION_RETRY_BATCH_SIZE=100

# =========================
# Firebase (base64-encoded service account JSON)
# =========================
FIREBASE_CREDENTIALS=

# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=

# =========================
# Security / docs
# =========================
# Swagger UI + /v3/api-docs. Off by default in the docker and prod profiles.
SWAGGER_ENABLED=false
# Login lockout: failures per email / per IP inside the window.
APP_SECURITY_LOGIN_MAX_FAILURES_PER_EMAIL=5
APP_SECURITY_LOGIN_MAX_FAILURES_PER_IP=20
APP_SECURITY_LOGIN_WINDOW_MINUTES=15
# Forgot password needs working SMTP_* settings above to deliver the code.
APP_SECURITY_PASSWORD_RESET_CODE_TTL_MINUTES=15

# =========================
# Timezone
# =========================
# Business timezone: due dates, reminders, bookings and performance periods all use it.
# BOOKING_TIMEZONE / TASK_REMINDER_DEFAULT_TIMEZONE / PERFORMANCE_TIMEZONE override it per feature.
TZ=Asia/Phnom_Penh

# =========================
# Uploads / API
# =========================
UPLOAD_MAX_FILE_SIZE=20MB
# All files of one request together (a submission's images + files).
UPLOAD_MAX_REQUEST_SIZE=100MB
API_MAX_PAGE_SIZE=1000
FLYWAY_ENABLED=true

# =========================
# Logging / monitoring
# =========================
LOG_LEVEL_ROOT=info
APP_LOG_LEVEL=info
MANAGEMENT_ENDPOINTS=health,info,metrics
MANAGEMENT_HEALTH_DETAILS=when-authorized
# graceful = finish in-flight requests on shutdown; immediate = stop at once.
SERVER_SHUTDOWN=graceful

# =========================
# Task reminders / overdue alerts
# =========================
TASK_REMINDER_DEFAULT_TIMES=09:00,13:00,17:00
# Daily overdue push (sec min hour day month weekday); "-" turns it off.
TASK_OVERDUE_CRON=0 0 9 * * *

# =========================
# Performance (star rating / top performers)
# =========================
# Relative weights of the five score parts.
PERFORMANCE_ON_TIME_WEIGHT=30
PERFORMANCE_QUALITY_WEIGHT=25
PERFORMANCE_COMPLETION_WEIGHT=20
PERFORMANCE_OVERDUE_WEIGHT=15
PERFORMANCE_SPEED_WEIGHT=10
PERFORMANCE_REJECTION_PENALTY=25
# 0 = late with a reason still counts as late; 0.5 = half credit; 1 = as if on time.
PERFORMANCE_LATE_WITH_REASON_CREDIT=0
PERFORMANCE_COUNT_COLLABORATORS=true
PERFORMANCE_MIN_TASKS_FOR_RATING=3
PERFORMANCE_FAIRNESS_TASKS=5
PERFORMANCE_FAIRNESS_BASELINE=70
# Top-performer popups: monthly on the 1st, yearly on 2 January, 09:00. "-" turns one off.
PERFORMANCE_AWARD_MONTHLY_CRON=0 0 9 1 * *
PERFORMANCE_AWARD_YEARLY_CRON=0 0 9 2 1 *
