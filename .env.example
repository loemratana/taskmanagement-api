# Copy this file to `.env` (local/dev) and fill in real values.
# For a production deployment, provide these as real environment variables
# (or a separate untracked `.env.production`) — never reuse dev secrets.

# =========================
# Spring
# =========================
# dev = local defaults, verbose logging, ddl-auto=update
# prod = requires every secret below to be set explicitly, ddl-auto=validate
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=tms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

DB_HOST=localhost
DB_PORT=5432

# =========================
# Redis
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379

# =========================
# pgAdmin (dev only)
# =========================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# =========================
# JWT
# =========================
# Generate a strong random secret, e.g.: openssl rand -base64 48
# Use a DIFFERENT secret per environment — never share dev/prod.
JWT_SECRET=
JWT_EXPIRE=28800000
JWT_ACCESS_TOKEN_EXPIRATION=604800000

# =========================
# Frontend / CORS
# =========================
CLIENT_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# SMTP
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# =========================
# Firebase (base64-encoded service account JSON)
# =========================
FIREBASE_CREDENTIALS=

# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=

# =========================
# Timezone
# =========================
TZ=Asia/Phnom_Penh
